{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A single clothing product in the Modivah Brechó stock catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string" },
        "size": { "type": "string" },
        "brand": { "type": "string" },
        "condition": { "type": "string" },
        "material": { "type": "string" },
        "image": { "type": "string" },
        "images": { "type": "array" },
        "video": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "reserved", "sold"] },
        "stock": { "type": "number" },
        "tag": { "type": "string" },
        "sku": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "description", "price", "category", "size", "brand", "condition", "material", "image", "status", "stock", "createdAt"]
    },
    "Client": {
      "title": "Client",
      "description": "User profile with PII data and consent tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastAccess": { "type": "string" },
        "purchasesCount": { "type": "number" },
        "totalSpent": { "type": "number" },
        "viewedProducts": { "type": "array" },
        "favoritedProducts": { "type": "array" },
        "cartProducts": { "type": "array" },
        "purchasedProducts": { "type": "array" },
        "consent": { "type": "boolean" },
        "passwordHash": { "type": "string" }
      },
      "required": ["id", "name", "email", "phone", "whatsapp", "city", "state", "createdAt", "lastAccess", "purchasesCount", "totalSpent", "consent", "passwordHash"]
    },
    "Order": {
      "title": "Order",
      "description": "Historic order transaction record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientPhone": { "type": "string" },
        "products": { "type": "array" },
        "quantity": { "type": "number" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "clientId", "clientName", "clientEmail", "products", "quantity", "total", "paymentMethod", "createdAt", "status"]
    },
    "CartRecovery": {
      "title": "CartRecovery",
      "description": "Abandoned cart session tracking and automated campaign registration.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientPhone": { "type": "string" },
        "clientWhatsapp": { "type": "string" },
        "products": { "type": "array" },
        "total": { "type": "number" },
        "createdAt": { "type": "string" },
        "isRecovered": { "type": "boolean" },
        "recoveryMessageSent": { "type": "boolean" }
      },
      "required": ["id", "clientId", "clientName", "clientEmail", "products", "total", "createdAt", "isRecovered", "recoveryMessageSent"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Analytical tracking instance logged for user interaction streams.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "type": { "type": "string", "enum": ["view", "click", "favorite", "cart_add", "purchase", "abandon_cart", "visit"] },
        "productId": { "type": "string" },
        "productTitle": { "type": "string" },
        "price": { "type": "number" },
        "createdAt": { "type": "string" },
        "userAgent": { "type": "string" },
        "origin": { "type": "string" }
      },
      "required": ["id", "clientId", "type", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Securely stored additional administrator login credential metadata.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "passwordHash": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["email", "passwordHash", "name", "role", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "User created categories which appear on the page filters and admin panels.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "image": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "order": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "order", "active"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "The shared live products catalog collection."
    },
    "categories/{categoryId}": {
      "schema": "Category",
      "description": "Customizable list of product categories dynamically managed by the admin."
    },
    "clients/{clientId}": {
      "schema": "Client",
      "description": "User profiles collection with PII attributes."
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Permanently stored sales purchase orders."
    },
    "cart_recovery/{recoveryId}": {
      "schema": "CartRecovery",
      "description": "Abandoned shopping cart sessions for recovery automation."
    },
    "activities/{activityId}": {
      "schema": "Activity",
      "description": "Analytical activity tracking streams."
    },
    "admins/{adminId}": {
      "schema": "Admin",
      "description": "Co-administrators with console edit permissions."
    }
  }
}
