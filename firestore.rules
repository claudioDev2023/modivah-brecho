rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(clientId) {
      return isSignedIn() && request.auth.uid == clientId;
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 10000
        && data.price is number && data.price >= 0
        && data.category is string && data.category.size() <= 100
        && data.size is string && data.size.size() <= 50
        && data.brand is string && data.brand.size() <= 100
        && data.condition is string && data.condition.size() <= 100
        && data.material is string && data.material.size() <= 500
        && data.image is string && data.image.size() <= 2000000
        && data.status is string && (data.status == 'available' || data.status == 'reserved' || data.status == 'sold')
        && data.stock is number && data.stock >= 0;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidProduct(request.resource.data);
      allow delete: if true;
    }

    match /stock_movements/{movId} {
      allow read, write: if true;
    }

    match /clients/{clientId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    match /cart_recovery/{recoveryId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /activities/{activityId} {
      allow read, write: if true;
    }

    match /comments/{commentId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
