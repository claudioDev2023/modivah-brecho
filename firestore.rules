rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 10000
        && data.price is number && data.price >= 0
        && data.category is string && data.category.size() <= 100
        && data.size is string && data.size.size() <= 50
        && data.brand is string && data.brand.size() <= 100
        && data.condition is string && data.condition.size() <= 100
        && data.material is string && data.material.size() <= 500
        && data.image is string && data.image.size() <= 5000
        && data.status is string && (data.status == 'available' || data.status == 'reserved' || data.status == 'sold')
        && data.stock is number && data.stock >= 0;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidProduct(request.resource.data);
      allow delete: if true;
    }
  }
}
