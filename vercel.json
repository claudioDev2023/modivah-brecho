{
  "version": 2,
  "headers": [
    {
      "source": "/products_real_backup.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/catalog-images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!.*\\.(?:json|js|css|png|jpg|jpeg|webp|svg|ico|txt|map)$).*)",
      "destination": "/index.html"
    }
  ]
}
